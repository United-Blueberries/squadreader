# cp .env.example .env — then fill in. .env is gitignored.
# Read by docker compose for the mounts AND passed into the container, where
# every SQREADER_<KEY> overrides that key of sqreader.config.json.

# Required: the game server's log directory on the host (contains SquadGame.log).
SQUAD_LOGS=/path/to/squad/SquadGame/Saved/Logs
# Required: the -Port= of the Squad server this reader attaches to.
SQREADER_SQUAD_PORT=

SQREADER_SERVER_ID=squad
# HTTP port of the replay viewer (bound to 127.0.0.1).
# SQREADER_PORT=8081

# Optional — any sqreader.config.json key works as SQREADER_<KEY>, e.g.:
# SQREADER_ALERT_WEBHOOK=        # credential; visible via `docker inspect`
# SQREADER_PLUGINS_CONFIG=/data/plugins_config.json
# SQREADER_CENTRAL_URL=
# SQREADER_PUSH_ENABLED=false
